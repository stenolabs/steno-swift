            "text": "Sprecher B",
            "wasConfirmedAtSource": false
          }
        }
      },
      "start": 9.7,
      "end": 17.414285714285715,
      "segments": [
        {
          "text": "Der erste Punkt ist die Übersicht. Jede Probe soll sofort ihren klaren Zweck zeigen.",
          "start": 9.7,
          "end": 17.414285714285715,
          "words": []
        }
      ]
