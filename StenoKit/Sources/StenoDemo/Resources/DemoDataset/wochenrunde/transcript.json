            "wasConfirmedAtSource": false
          }
        }
      },
      "start": 23.9,
      "end": 34.632879818594105,
      "segments": [
        {
          "text": "Der dritte Punkt betrifft die Notizen. Sie bleiben bewusst knapp und vollständig erfunden.",
          "start": 23.9,
          "end": 34.632879818594105,
          "words": []
        }
      ]
    },
    {
      "speaker": {
        "importedTextLabel": {
