            "wasConfirmedAtSource": false
          }
        }
      },
      "start": 19.1,
      "end": 23.142902494331064,
      "segments": [
        {
          "text": "Beim zweiten Punkt ergänze ich einen kurzen Hinweis für die lokale Auswertung.",
          "start": 19.1,
          "end": 23.142902494331064,
          "words": []
        }
      ]
    },
    {
