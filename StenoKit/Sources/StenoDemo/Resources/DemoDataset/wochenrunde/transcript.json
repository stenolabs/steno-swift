      "start": 0.0,
      "end": 9.232562358276644,
      "segments": [
        {
          "text": "In dieser fiktiven Wochenrunde prüfen wir drei kleine Verbesserungen am Beispielablauf.",
          "start": 0.0,
          "end": 9.232562358276644,
          "words": []
        }
