            "text": "Sprecher B",
            "wasConfirmedAtSource": false
          }
        }
      },
      "start": 37.3,
      "end": 44.143537414965984,
      "segments": [
        {
          "text": "Für diese Runde gibt es keine offenen Risiken. Wir dokumentieren nur die geplante Reihenfolge.",
          "start": 37.3,
          "end": 44.143537414965984,
          "words": []
        }
      ]
    },
    {
      "speaker": {
        "importedTextLabel": {
