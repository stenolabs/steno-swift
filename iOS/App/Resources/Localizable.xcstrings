          }
        }
      }
    },
    "This transcript changed while you were editing. Steno did not overwrite it. The current version has been reloaded and your draft remains here. Copy it if needed, then cancel and reopen the current line before saving." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Transkript wurde während deiner Bearbeitung geändert. Steno hat es nicht überschrieben. Die aktuelle Version wurde neu geladen und dein Entwurf bleibt hier erhalten. Kopiere ihn bei Bedarf, brich dann ab und öffne die aktuelle Zeile erneut, bevor du speicherst."
          }
        }
      }
    },
    "This transfer contains an unencrypted raw recording and may include voices of other people." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
