    "meeting.deletion.message" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der gesamte Meeting-Ordner einschließlich Originalaufnahme, Transkriptrevisionen, Notizen und Protokollen wird in den Papierkorb des Systems verschoben. Steno bietet keine Wiederherstellung innerhalb der App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The entire meeting folder, including its original recording, transcript revisions, notes, and reports, moves to the system Trash. Steno has no in-app restore."
          }
        }
      }
    },
    "meeting.retranscription.message" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steno fügt eine neue Transkriptrevision hinzu und behält das aktuelle Transkript und die Korrekturen als frühere Revisionen.\nDie Sprechertrennung läuft mit neuen Cluster-Kennungen erneut, daher müssen Sprecher danach erneut bestätigt werden.\nDeine Korrekturen werden niemals stillschweigend überschrieben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Steno adds a new transcript revision and keeps the current transcript and corrections as earlier revisions.\nSpeaker separation runs again with new cluster identifiers, so speakers must be confirmed again.\nYour corrections are never silently overwritten."
          }
        }
      }
    },
