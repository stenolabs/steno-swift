      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suche schließen"
          }
        }
      }
    },
    "Closing stops the current check or import and removes Steno's private prepared copy." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Schließen wird die aktuelle Prüfung oder der Import beendet und Stenos private vorbereitete Kopie entfernt."
          }
        }
      }
    },
    "Compute diarization and speaker suggestions for this meeting" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diarisierung und Sprechervorschläge für dieses Meeting berechnen"
          }
        }
      }
    },
    "Compute precise timestamps, diarization and speaker suggestions" : {
      "localizations" : {
