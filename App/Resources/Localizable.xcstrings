      }
    },
    "Tokens per request. Must match what the server actually loads. Too small a value splits a long meeting into so many pieces that the summary no longer converges." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token pro Anfrage. Der Wert muss dem entsprechen, was der Server tatsächlich lädt. Ein zu kleiner Wert teilt ein langes Meeting in so viele Teile, dass die Zusammenfassung nicht mehr zusammenfindet."
          }
        }
      }
    },
