    },
    "Used to tell people apart as the voice database grows - two people with the same name are normal there. Both stay in your library and never reach a language model." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hilft, Personen bei wachsender Stimmdatenbank auseinanderzuhalten. Zwei Personen mit demselben Namen sind dort normal. Beide bleiben in deiner Bibliothek und erreichen niemals ein Sprachmodell."
          }
        }
      }
    },
