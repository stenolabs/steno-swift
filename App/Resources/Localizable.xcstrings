    "A different version of this source meeting is already present. Steno will not overwrite, merge or duplicate it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine andere Version dieses Quell-Meetings ist bereits vorhanden. Steno überschreibt, vereinigt und dupliziert sie nicht."
          }
        }
      }
    },
    "A new transcript is added; the current one stays available as an earlier version. Speaker assignments for this meeting have to be confirmed again afterwards." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein neues Transkript wird hinzugefügt. Das aktuelle bleibt als frühere Version erhalten. Die Sprecherzuordnungen für dieses Meeting müssen danach erneut bestätigt werden."
          }
        }
      }
    },
    "A newer transcription is ready. Your correction is shown instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine neuere Transkription ist fertig. Stattdessen wird deine Korrektur angezeigt."
          }
        }
      }
    },
    "A person named %@ already exists." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Person namens %1$@ ist bereits vorhanden."
          }
        }
      }
    },
    "A temporary meeting export could not be verified and was preserved for manual cleanup." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein temporärer Meeting-Export konnte nicht verifiziert werden und wurde zur manuellen Bereinigung beibehalten."
          }
        }
      }
    },
    "About 461 MB from huggingface.co" : {
      "localizations" : {
