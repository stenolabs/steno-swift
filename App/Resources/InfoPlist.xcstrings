    "NSAudioCaptureUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steno zeichnet Systemaudio auf, um die Personen in deinen Gesprächen lokal auf diesem Mac zu transkribieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steno records system audio so it can transcribe the people you talk to in calls, locally on this Mac."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Steno 錄製系統音訊以在 Mac 本機轉錄通話中的與會者發言。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steno verwendet dein Mikrofon, um Gespräche lokal auf diesem Mac zu transkribieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steno records your microphone so it can transcribe conversations locally on this Mac."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Steno 使用您的麥克風在 Mac 本機轉錄對話。"
          }
        }
      }
    },
    "Steno Meeting": {
