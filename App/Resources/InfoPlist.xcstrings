    "NSAudioCaptureUsageDescription":  {
      "extractionState":  "manual",
      "localizations":  {
        "de":  {
          "stringUnit":  {
            "state":  "translated",
            "value":  "Steno zeichnet Systemaudio auf, um die Personen in deinen Gesprächen lokal auf diesem Mac zu transkribieren."
          }
        },
        "en":  {
          "stringUnit":  {
            "state":  "translated",
            "value":  "Steno records system audio so it can transcribe the people you talk to in calls, locally on this Mac."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription":  {
      "extractionState":  "manual",
      "localizations":  {
