# Session handoffs are never versioned
HANDOFF.md
HANDOFF-*.md
PLAN-INTEGRATION.md
PLAN-S*.md
UEBERGABE*.md

# Local agent runtime state (PID, port, token)
.superpowers/

# Swift / SwiftPM (Package.resolved is versioned intentionally to pin dependencies)
.build/
.swiftpm/
# Exception: StenoiOSKit depends on StenoKit only through a local path and
# inherits its only external pin from there. Two lock files for the same pin
# can drift; StenoKit/Package.resolved is authoritative.
iOS/StenoiOSKit/Package.resolved

# Xcode
DerivedData/
xcuserdata/
*.xcuserstate
*.xcresult
.steno-signing.xcconfig

# macOS
.DS_Store

# Local artifacts
*.log
# Both Xcode projects are generated from project.yml and are never maintained
# manually. A committed generated project would become stale immediately.
Steno.xcodeproj/
Steno27.xcodeproj/
iOS/StenoiOS.xcodeproj/
iOS/build/
# The same applies to Info.plist files. XcodeGen writes them completely from
# the info block in project.yml, so committed copies would drift from their
# source and produce the same generated diff after every build.
App/Info.plist
iOS/App/Info.plist

# Isolated worktrees for parallel tasks
.worktrees/
